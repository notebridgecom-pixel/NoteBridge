rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'rajbhosaletkd@gmail.com' ||
        request.auth.token.email == 'admin@notebridge.in' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // --- ENTITY VALIDATIONS ---

    function isValidUser(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 150 &&
             data.email is string && data.email.size() <= 150 &&
             data.role in ['buyer', 'seller', 'admin'] &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
             (!('college' in data) || (data.college is string && data.college.size() <= 200)) &&
             (!('university' in data) || (data.university is string && data.university.size() <= 200)) &&
             (!('degree' in data) || (data.degree is string && data.degree.size() <= 100)) &&
             (!('branch' in data) || (data.branch is string && data.branch.size() <= 100)) &&
             (!('walletBalance' in data) || data.walletBalance is number) &&
             (!('totalEarnings' in data) || data.totalEarnings is number);
    }

    function isValidNote(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.subject is string && data.subject.size() <= 150 &&
             data.university is string && data.university.size() <= 200 &&
             data.price is number && data.price >= 0 && data.price <= 1000 &&
             data.sellerId is string && data.sellerId.size() <= 128 &&
             data.sellerName is string && data.sellerName.size() <= 150 &&
             data.status in ['approved', 'pending', 'rejected', 'changes_requested'] &&
             (!('description' in data) || (data.description is string && data.description.size() <= 2000)) &&
             (!('textContent' in data) || (data.textContent is string && data.textContent.size() <= 25000)) &&
             (!('aiSynopsis' in data) || (data.aiSynopsis is string && data.aiSynopsis.size() <= 6000));
    }

    function isValidOrder(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.noteId is string && data.noteId.size() <= 128 &&
             data.sellerId is string && data.sellerId.size() <= 128 &&
             data.buyerId is string && data.buyerId.size() <= 128 &&
             data.amount is number && data.amount >= 0 &&
             data.status in ['completed', 'pending_verification', 'rejected', 'failed', 'refunded'] &&
             (!('orderNumber' in data) || (data.orderNumber is string && data.orderNumber.size() <= 50)) &&
             (!('noteTitle' in data) || (data.noteTitle is string && data.noteTitle.size() <= 200)) &&
             (!('subject' in data) || (data.subject is string && data.subject.size() <= 150)) &&
             (!('sellerName' in data) || (data.sellerName is string && data.sellerName.size() <= 150)) &&
             (!('buyerName' in data) || (data.buyerName is string && data.buyerName.size() <= 150)) &&
             (!('buyerEmail' in data) || (data.buyerEmail is string && data.buyerEmail.size() <= 150)) &&
             (!('buyerPhone' in data) || (data.buyerPhone is string && data.buyerPhone.size() <= 50)) &&
             (!('sellerShare' in data) || data.sellerShare is number) &&
             (!('platformShare' in data) || data.platformShare is number) &&
             (!('purchasedAt' in data) || (data.purchasedAt is string && data.purchasedAt.size() <= 50)) &&
             (!('watermarkText' in data) || (data.watermarkText is string && data.watermarkText.size() <= 250)) &&
             (!('upiTransactionId' in data) || (data.upiTransactionId is string && data.upiTransactionId.size() <= 50));
    }

    function isValidWithdrawal(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.sellerId is string && data.sellerId.size() <= 128 &&
             data.amount is number && data.amount > 0 &&
             data.upiId is string && data.upiId.size() <= 100 &&
             data.status in ['processing', 'completed', 'rejected'];
    }

    function isValidStudySpace(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.displayName is string && data.displayName.size() <= 200 &&
             data.subject is string && data.subject.size() <= 150 &&
             data.createdBy is string && data.createdBy.size() <= 128;
    }

    function isValidDriveBackup(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.noteId is string && data.noteId.size() <= 128 &&
             data.driveFileId is string && data.driveFileId.size() <= 200;
    }

    // --- USERS COLLECTION ---
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming()) && incoming().role != 'admin';
      allow update: if (isOwner(userId) && isValidUser(incoming()) && (existing().role == 'admin' || incoming().role != 'admin')) || isAdmin();
      allow delete: if isAdmin();
    }

    // --- NOTES COLLECTION ---
    match /notes/{noteId} {
      allow get: if true; // Publicly previewable catalog
      allow list: if true; // Publicly browsable
      allow create: if isSignedIn() && isValidNote(incoming()) && (incoming().sellerId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && isValidNote(incoming()) && (existing().sellerId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (existing().sellerId == request.auth.uid || isAdmin());
    }

    // --- ORDERS COLLECTION ---
    match /orders/{orderId} {
      allow get: if isSignedIn() && (existing().buyerId == request.auth.uid || existing().sellerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidOrder(incoming()) && (incoming().buyerId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && isValidOrder(incoming()) && (existing().buyerId == request.auth.uid || existing().sellerId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // --- WITHDRAWALS COLLECTION ---
    match /withdrawals/{withdrawalId} {
      allow get: if isSignedIn() && (existing().sellerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidWithdrawal(incoming()) && (incoming().sellerId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // --- STUDY SPACES COLLECTION (Google Chat integration) ---
    match /studySpaces/{spaceId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidStudySpace(incoming()) && (incoming().createdBy == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && isValidStudySpace(incoming()) && (existing().createdBy == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (existing().createdBy == request.auth.uid || isAdmin());
    }

    // --- DRIVE BACKUPS COLLECTION (Google Drive integration) ---
    match /driveBackups/{backupId} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidDriveBackup(incoming()) && (incoming().userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && isValidDriveBackup(incoming()) && (existing().userId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    // --- SYSTEM & TEST LOGS ---
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
